---
import linkedin from '../assets/linkedin.svg';
import github from '../assets/github.svg';
---

<div class="flex flex-col mt-16">
    <section class="flex flex-col font-jersey rounded-2xl py-6">
        <h2 class="text-4xl text-[#EAE6E3] tracking-wide min-[1100px]:sr-only">Let’s talk.</h2>
        <p class="text-xl text-[#EAE6E3] mt-1">Whether you are looking to collaborate on a project,
            or just want to chat, please feel free to reach out to me : )</p>
        <div class="flex flex-row gap-4 place-items-center mt-4">
            <a class="flex flex-row gap-2" href="https://www.linkedin.com/in/brandoneastwell/" target="_blank">
                <img class="h-6 opacity-80 transition duration-300 hover:opacity-100 cursor-pointer" src={linkedin.src}  alt="linkedin icon" />
                <span class="text-[#EAE6E3]">LinkedIn</span>
            </a>
            <a class="flex flex-row gap-2" href="https://github.com/brandoneastwell/" target="_blank">
                <img class="h-6 opacity-80 transition duration-300 hover:opacity-100 cursor-pointer" src={github.src}  alt="github icon" />
                <span class="text-[#EAE6E3]">GitHub</span>
            </a>
        </div>
        <a href="mailto:brandoneastwell@gmail.com" class="group mt-5 flex items-center justify-between gap-3 rounded-lg border border-white/15 bg-white/5 px-3 py-2.5 text-[#EAE6E3] transition-colors hover:border-white/35 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#EAE6E3]">
            <span class="min-w-0">
                <span class="block text-sm uppercase tracking-wider text-[#EAE6E3]/65">Email</span>
                <span class="block break-all font-hanken text-sm">brandoneastwell@gmail.com</span>
            </span>
            <span class="shrink-0 text-lg text-[#EAE6E3]/65 group-hover:text-[#EAE6E3]" aria-hidden="true">↗</span>
        </a>
    </section>
    <span class="text-xl font-jersey text-[#EAE6E3] mt-4 place-self-center">brandon eastwell ©2026</span>
    <span class="text-xl font-jersey text-[#EAE6E3] place-self-center">London, UK</span>
</div>
