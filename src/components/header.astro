---
import pic from "../assets/DSCF1863.JPG"
import Education from "./education.astro";
---

<section class="mt-16 h-auto">
    <div class="font-jersey text-[#EAE6E3] flex flex-col justify-center">
        <div class="flex flex-row justify-between place-items-center">
            <div class="relative">
                <span class="name absolute -top-4" >hey, i am</span>
                <h1 class="name text-6xl">BRANDON</h1>
                <h1 class="name text-6xl">EASTWELL</h1>
            </div>
            <img src={pic.src} alt="" class="pic w-36 aspect-square object-cover rounded-full place-self-center" />
        </div>
        <p class="role text-2xl font-jersey text-[#EAE6E3] tracking-wide mt-2">Full-Stack Software Engineer</p>
    </div>
    <p class="desc mt-8 min-[550px]:mt-4 text-xl font-jersey text-[#EAE6E3]/80">I’m a first-class Computer Science graduate and full-stack developer with an interest in applying AI to existing products. I built an offline hiking journal that saves notes and sketches and syncs them when users reconnect. I’m exploring that interest by adding a Python and FastAPI service to the journal to help hikers find patterns in their past reflections.</p>
    <Education />
</section>

<script>
    import { gsap } from "gsap";
    const nameEle = document.querySelectorAll(".name");
    let tl = gsap.timeline();


    if (sessionStorage.getItem('initialLoad') === null) {
        gsap.fromTo(".pic", { opacity: 0, filter: 'blur(5px)', }, { opacity: 1, filter: 'blur(0px)', duration: 1 })
        tl.fromTo(nameEle[0], { y: -10, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4 })
            .fromTo(nameEle[1], { y: -10, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4 }, "-=0.2")
            .fromTo(nameEle[2], { y: -10, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6 }, "-=0.2")
            .fromTo(".role", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "power2.out"  }, "-=0.4")
            .fromTo(".desc", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "power2.out" }, "-=0.3" )
            .fromTo(".uni", { opacity: 0, filter: 'blur(5px)', }, { opacity: 1, filter: 'blur(0px)', duration: 0.2 }, "-=0.2")
            .fromTo(".time", { x: -20, opacity: 0 }, { x: 0, opacity: 1, duration: 0.4, ease: "power2.out" }, "-=0.2")
            .fromTo(".title", { x: -20, opacity: 0 }, { x: 0, opacity: 1, duration: 0.4, ease: "power2.out" }, "-=0.3")
            .fromTo(".course", { x: -20, opacity: 0 }, { x: 0, opacity: 1, duration: 0.4, ease: "power2.out" }, "-=0.3")

        sessionStorage.setItem('initialLoad', "true")
    }


</script>