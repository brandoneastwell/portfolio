---
import pic from "../assets/DSCF1863.JPG";
import Education from "./education.astro";
---

<section class="profile mt-16 h-auto">
    <div class="identity font-jersey text-[#EAE6E3]">
        <div class="profile-heading relative">
            <span class="profile-greeting absolute -top-4">hey, i am</span>
            <h1 class="profile-name leading-none">
                <span>BRANDON</span> <span>EASTWELL</span>
            </h1>
        </div>
        <p class="role mt-2 text-2xl tracking-wide">Full-Stack Software Engineer</p>
        <img src={pic.src} alt="" class="pic aspect-square object-cover rounded-full" />
        <div class="profile-details"><Education compact /></div>
    </div>
</section>

<style>
    .identity {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        column-gap: 1.5rem;
        align-items: center;
    }

    .profile-heading,
    .profile-name {
        width: max-content;
    }

    .profile-name {
        font-size: clamp(2.5rem, 13vw, 3.75rem);
    }

    .profile-name span {
        display: block;
        width: max-content;
    }

    .role {
        grid-column: 1 / -1;
    }

    .pic {
        grid-column: 2;
        grid-row: 1;
        width: 100%;
        max-width: 8.75rem;
        justify-self: end;
    }

    .profile-details {
        display: none;
    }

    @media (min-width: 1100px) {
        .profile {
            margin-top: 0;
        }

        .identity {
            grid-template-columns: 7rem minmax(0, 1fr);
            column-gap: 1.125rem;
        }

        .profile-heading {
            grid-column: 1 / -1;
        }

        .profile-details {
            display: block;
            grid-column: 2;
            grid-row: 3;
            margin-top: 0.75rem;
        }

        .profile-greeting {
            display: none;
        }

        .profile-heading,
        .profile-name {
            width: auto;
        }

        .profile-name {
            font-size: clamp(3.5rem, 3.55vw, 4rem);
            letter-spacing: 0.02em;
            white-space: nowrap;
        }

        .profile-name span {
            display: inline;
        }

        .role {
            margin-top: 0.25rem;
        }

        .pic {
            grid-column: 1;
            grid-row: 3;
            width: 7rem;
            margin-top: 0.75rem;
            justify-self: start;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    let tl = gsap.timeline();


    if (sessionStorage.getItem('initialLoad') === null) {
        gsap.fromTo(".pic", { opacity: 0, filter: 'blur(5px)', }, { opacity: 1, filter: 'blur(0px)', duration: 1 })
        tl.fromTo(".profile-heading", { y: -10, opacity: 0 }, { y: 0, opacity: 1, duration: 0.55 })
            .fromTo(".role", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "power2.out"  }, "-=0.4")
            .fromTo(".desc", { opacity: 0 }, { opacity: 1, duration: 0.4, ease: "power2.out" }, "-=0.3" )
            .fromTo(".uni", { opacity: 0, filter: 'blur(5px)', }, { opacity: 1, filter: 'blur(0px)', duration: 0.2 }, "-=0.2")
            .fromTo(".time", { x: -20, opacity: 0 }, { x: 0, opacity: 1, duration: 0.4, ease: "power2.out" }, "-=0.2")
            .fromTo(".title", { x: -20, opacity: 0 }, { x: 0, opacity: 1, duration: 0.4, ease: "power2.out" }, "-=0.3")
            .fromTo(".course", { x: -20, opacity: 0 }, { x: 0, opacity: 1, duration: 0.4, ease: "power2.out" }, "-=0.3")

        sessionStorage.setItem('initialLoad', "true")
    }


</script>