---
import Tool from "./tool.astro";
const { gitUrl, liveUrl, title, description, img, tools, toolBackground, edgeColor, slug } = Astro.props
import github from '../assets/github.svg';
import arrow from '../assets/arrow-right-up-line.svg';
---

<div class="foreground-plane project-plane">
    <div class="project-shell" style={`--project-tool-background: ${toolBackground}; ${edgeColor ? `--project-edge-color: ${edgeColor};` : ""}`}>
        <article class="project relative isolate flex w-full flex-col items-start justify-center gap-4 text-left overflow-hidden rounded-2xl bg-[#1A1A1B] p-6">
            <img class="project-image absolute inset-0 -z-20 h-full w-full object-cover object-top" src={img} alt="" />
            <div class="project-overlay absolute inset-0 -z-10 bg-[#1A1A1B]/80" aria-hidden="true"></div>
            <div class="project-details">
                <h3 class="font-jersey text-2xl text-[#EAE6E3]">
                    <a href={`/projects/${slug}/`} class="after:absolute after:inset-0 after:z-[1] focus-visible:after:ring-2 focus-visible:after:ring-inset focus-visible:after:ring-white">
                        {title} <img class="project-arrow inline h-5" src={arrow.src} alt="" />
                    </a>
                </h3>
                <p class="mt-2 max-w-[38ch] font-hanken text-base font-medium leading-snug text-[#EAE6E3]">{description}</p>
                <div class="mt-2 flex flex-wrap gap-x-1">
                    {tools.map((tool) => <Tool tool={tool} />)}
                </div>
            </div>
            <div class="flex flex-wrap gap-2">
                <a class="project-action" href={gitUrl} target="_blank" rel="noopener noreferrer">
                    <img class="h-4 w-4" src={github.src} alt="" /> View code
                </a>
                {liveUrl && (
                    <a class="project-action" href={liveUrl} target="_blank" rel="noopener noreferrer">Try live demo</a>
                )}
            </div>
        </article>
        <span class="project-edge" aria-hidden="true"><span class="project-edge-track"></span></span>
    </div>
</div>

<style>
    @reference "../styles/global.css";

    .project {
        min-height: var(--project-height, 250px);
    }

    .project-image {
        filter: grayscale(1) blur(2px);
    }

    .project:focus-within .project-image {
        filter: none;
    }

    @media (hover: hover) {
        .project:hover .project-image {
            filter: none;
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .project-image {
            transition: filter 360ms ease;
        }
    }

    .project-action {
        @apply relative z-10 inline-flex min-h-8 items-center gap-1.5 rounded-lg border border-white/20 bg-[#1A1A1B]/85 px-2.5 font-hanken text-sm text-[#EAE6E3] transition-colors hover:border-white/45 hover:bg-[#343435] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white;
    }

    .project-details :global(.tool) {
        font-size: 0.75rem;
    }

    @property --foreground-depth {
        syntax: "<length>";
        inherits: false;
        initial-value: 0px;
    }

    .project-plane {
        --foreground-depth: 22px;
        --foreground-tilt: 3.5deg;
    }

    .project-shell {
        position: relative;
        isolation: isolate;
    }

    .project-edge {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0;
        filter: blur(5px)
            drop-shadow(0 0 5px rgb(255 255 255 / 75%))
            drop-shadow(0 0 26px rgb(255 255 255 / 48%));
    }

    .project-edge-track {
        position: absolute;
        inset: 0;
        padding: 2px;
        border-radius: 1rem;
        mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        mask-composite: exclude;
    }

    .project-edge-track::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 14rem;
        height: 14rem;
        --edge-tint: var(--project-edge-color, color-mix(in srgb, var(--project-tool-background) 75%, white));
        background: radial-gradient(
            circle closest-side,
            color-mix(in srgb, var(--edge-tint) 62%, transparent),
            color-mix(in srgb, var(--edge-tint) 60%, transparent) 25%,
            color-mix(in srgb, var(--edge-tint) 35%, transparent) 60%,
            transparent
        );
        offset-path: inset(1px round 15px);
        offset-rotate: 0deg;
        offset-distance: 21%;
        pointer-events: none;
    }

    .project-details {
        --tool-background: color-mix(in srgb, var(--project-tool-background) 25%, #212121);
    }

    .project-arrow {
        opacity: 0;
    }

    .project:focus-within .project-arrow {
        opacity: 1;
        transform: none;
    }

    @media (hover: hover) {
        .project-shell:hover .project-edge {
            opacity: 1;
        }

        .project-shell:hover .project-edge-track::before {
            offset-distance: 36%;
        }

        .project:hover .project-details {
            --tool-background: var(--project-tool-background);
        }

        .project:hover .project-arrow {
            opacity: 1;
            transform: none;
        }
    }

    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .project-plane {
            transition: --foreground-depth 300ms ease;
        }

        .project-plane:hover {
            --foreground-depth: 42px;
        }

        .project-edge {
            transition: opacity 160ms ease;
        }

        .project-edge-track::before {
            transition: offset-distance 0s 160ms;
        }

        .project-shell:hover .project-edge-track::before {
            transition: offset-distance 450ms cubic-bezier(0.12, 0.8, 0.25, 1);
        }

        .project-arrow {
            transition: opacity 200ms ease, transform 200ms ease;
        }

        .project:not(:hover):not(:focus-within) .project-arrow {
            transform: translate(-0.4rem, 0.4rem);
        }

        .project-details :global(.tool) {
            transition: background-color 340ms ease-in-out;
        }

        .project:hover .project-details :global(.tool) {
            transition-duration: 220ms;
        }

        .project-overlay {
            transition: background-color 260ms ease;
        }

        .project:hover .project-overlay {
            background-color: rgb(26 26 27 / 74%);
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const motion = gsap.matchMedia();
    motion.add({
        allowMotion: "(prefers-reduced-motion: no-preference)",
        wide: "(min-width: 760px)",
        twoColumnHomepage: "(min-width: 1100px)",
    }, ({ conditions }) => {
        if (!conditions?.allowMotion) return;

        document.querySelectorAll<HTMLElement>(".project-shell").forEach((card, index) => {
            const columnIndex = conditions.twoColumnHomepage ? index : index - 1;
            const direction = conditions.wide && columnIndex >= 0 ? (columnIndex % 2 === 0 ? -1 : 1) : 0;

            gsap.timeline({
                defaults: { ease: "none" },
                scrollTrigger: {
                    trigger: card.parentElement,
                    start: "top 99%",
                    end: "bottom 1%",
                    scrub: 0.45,
                },
            })
                .fromTo(card,
                    {
                        x: direction * 44,
                        y: direction ? 16 : 30,
                        rotationX: 6,
                        rotationZ: direction * 1.5,
                        opacity: 0,
                        transformPerspective: 900,
                    },
                    {
                        x: 0,
                        y: 0,
                        rotationX: 0,
                        rotationZ: 0,
                        opacity: 1,
                        duration: 0.19,
                        ease: "power2.out",
                    }
                )
                .to(card, {
                    x: direction * 30,
                    y: -24,
                    rotationX: -5,
                    rotationZ: direction * 1.2,
                    opacity: 0,
                    duration: 0.17,
                    ease: "power1.in",
                }, 0.83);
        });
    });
</script>
