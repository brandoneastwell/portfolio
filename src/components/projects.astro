---
import Project from "./project.astro";
import sivterDemo from "../assets/landing-demo.gif"
import raDemo from "../assets/ra-demo.gif"
import lrsDemo from "../assets/lrs-services.vercel.app_(iPhone 14 Pro Max).png"
import photoappDemo from "../assets/photoapp-cover.gif"
import outdoorReflectionsDemo from "../assets/outdoor-reflections-page.png"
---

<section class="projects-section mt-16">
    <p class="text-xl text-[#EAE6E3] font-jersey uppercase tracking-widest"> Projects </p>
    <div class="flex flex-col flex-wrap gap-6 mt-6">
        <Project index="1" img={outdoorReflectionsDemo.src} gitUrl="https://github.com/brandoneastwell/outdoor-reflections" liveUrl="https://outdoor-reflections.vercel.app"
                 title="Outdoor Reflections - Offline Journal" tools={["React", "TypeScript", "Next.js", "NestJS", "Prisma", "PostgreSQL"]} />
        <Project index="2" img={photoappDemo.src} gitUrl="https://github.com/brandoneastwell/photography-app" liveUrl="https://photosmap.co.uk"
                 title="Photography Sharing & Search Platform" tools={["React Native", "TypeScript", "Python", "Django", "PostgreSQL", "Mobile & Web"]} />
        <Project index="3" img={sivterDemo.src} gitUrl="https://github.com/brandoneastwell/movie-discovery-app" liveUrl="https://sivter-app.vercel.app/"
                 title="Sivter Movie Discovery" tools={["Next.js", "React", "TailwindCSS", "TypeScript", "Prisma", "PostgreSQL"]} />
        <Project index="4" img={raDemo.src} gitUrl="https://github.com/brandoneastwell/ra-set-finder" liveUrl="https://github.com/BrandonEastwell/ra-set-finder"
                 title="RA Set Finder" tools={["React", "TypeScript", "TailwindCSS", "Express", "Chrome Extension"]} />
        <Project index="5" img={lrsDemo.src} gitUrl="https://github.com/brandoneastwell/lrs-services" liveUrl="https://lrs-services.vercel.app/"
                 title="LRS Exterior Services" tools={["React", "TypeScript", "TailwindCSS", "Express"]} />
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger)
    const title = document.querySelector('.projects-section p');

    if (title) {
        gsap.fromTo(title,
            { x: -10, opacity: 0 },
            {
                x: 0,
                opacity: 1,
                duration: 0.8,
                ease: 'power2.out',
                scrollTrigger: {
                    trigger: title,
                    start: 'top 100%',
                }
            }
        );
    }

</script>