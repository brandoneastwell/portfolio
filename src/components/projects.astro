---
import Project from "./project.astro";
import { projects } from "../data/projects";
---

<section id="projects" class="projects-section mx-auto mt-16 w-full max-w-[430px] scroll-mt-24 px-6">
    <h2 class="mx-auto max-w-[382px] text-xl text-[#EAE6E3] font-jersey uppercase tracking-widest min-[1100px]:sr-only">Projects</h2>
    <div class="project-list mt-6 grid items-start gap-9 min-[1100px]:mt-0">
        {projects.map((project) => <Project {...project} />)}
    </div>
</section>

<style>
    @media (min-width: 760px) {
        .projects-section {
            max-width: 62rem;
            padding-inline: 2rem;
        }

        .project-list {
            grid-template-columns: minmax(0, 1.07fr) minmax(0, 1fr);
            gap: 0 var(--project-column-gap, clamp(2.75rem, 7vw, 6rem));
        }

    }

    @media (760px <= width < 1100px) {
        .project-list > :global(:first-child) {
            grid-column: 1 / -1;
            width: min(49%, 30rem);
            justify-self: center;
            margin-inline-end: clamp(1.5rem, 9vw, 8rem);
            margin-bottom: 5rem;
            --project-height: 23rem;
        }

        .project-list > :global(:nth-child(2n + 2)) {
            --project-height: 18rem;
            width: 88%;
            justify-self: start;
        }

        .project-list > :global(:nth-child(2n + 3)) {
            --project-height: 16.5rem;
            width: 100%;
            justify-self: end;
            margin-top: 9rem;
        }

        .project-list > :global(:nth-child(4)) {
            --project-height: 16rem;
            width: 100%;
            justify-self: end;
            margin-top: -1rem;
        }

        .project-list > :global(:nth-child(5)) {
            --project-height: 19rem;
            width: 84%;
            margin-top: 7rem;
        }
    }

    @media (min-width: 1100px) {
        .project-list {
            row-gap: 2rem;
        }

        .project-list > :global(:nth-child(odd)) {
            --project-height: 17rem;
        }

        .project-list > :global(:nth-child(even)) {
            --project-height: 16rem;
            margin-top: 3.5rem;
        }

        .project-list > :global(:first-child) {
            --project-height: 21rem;
        }

        .project-list > :global(:nth-child(3)) {
            width: 92%;
        }

        .project-list > :global(:nth-child(4)) {
            --project-height: 18rem;
            margin-top: 4.5rem;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger)
    const title = document.querySelector('.projects-section h2');

    if (title) {
        gsap.fromTo(title,
            { x: -10, opacity: 0 },
            {
                x: 0,
                opacity: 1,
                duration: 0.8,
                ease: 'power2.out',
                scrollTrigger: {
                    trigger: title,
                    start: 'top 100%',
                }
            }
        );
    }

</script>