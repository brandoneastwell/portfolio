---
import download from '../assets/download.svg';
import resumeUrl from '../assets/brandon_eastwell_cv.pdf?url';
---

<a href={resumeUrl} download="brandon_eastwell_cv.pdf" data-resume-download
    class="group inline-flex min-h-7 min-w-[100px] items-center justify-center gap-1.5 rounded-lg border border-white/15 bg-white/5 px-2.5 font-jersey text-sm text-[#EAE6E3] transition-colors hover:border-white/35 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#EAE6E3]">
    <img class="h-4 w-4 opacity-65 transition-opacity group-hover:opacity-100" src={download.src} alt="" />
    <span>Resume</span>
</a>

<script>
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-resume-download]");

    function showDownloadState() {
        for (const link of links) {
            const label = link.querySelector("span");
            if (label) label.textContent = "Downloaded";
        }
    }

    if (sessionStorage.getItem("resumeDownloaded") === "true") {
        showDownloadState();
    }

    for (const link of links) {
        link.addEventListener("click", () => {
            sessionStorage.setItem("resumeDownloaded", "true");
            showDownloadState();
        });
    }
</script>
