---
import  SpeedInsights  from "@vercel/speed-insights/astro"
import Analytics from '@vercel/analytics/astro'

const { title = 'Brandon Eastwell | Software Engineer' } = Astro.props;

---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Full-Stack, Software Engineer Portfolio">
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png?v=2" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="portfolio-background">
		<SpeedInsights />
		<Analytics />
        <div class="ambient-viewport" aria-hidden="true">
            <div class="ambient-light">
                <canvas class="ambient-static"></canvas>
                <canvas class="ambient-dust"></canvas>
            </div>
        </div>
		<slot />
	</body>
</html>
<script>
    import { createAmbientStatic } from "../scripts/ambient-static";

    const dust = document.querySelector<HTMLCanvasElement>(".ambient-dust");
    const light = dust?.parentElement;
    const context = dust?.getContext("2d");

    if (dust && light && context) {
        const canvas = dust;
        const ambientLight = light;
        const ctx = context;
        const staticCanvas = ambientLight.querySelector<HTMLCanvasElement>(".ambient-static");
        const animatedStatic = staticCanvas ? createAmbientStatic(staticCanvas) : null;

        if (animatedStatic && staticCanvas) {
            ambientLight.classList.add("has-animated-static");
            staticCanvas.addEventListener("webglcontextlost", () => {
                ambientLight.classList.remove("has-animated-static");
            });
        }

        const motion = window.matchMedia("(prefers-reduced-motion: no-preference)");
        const motes = Array.from({ length: 280 }, () => ({
            x: 0.18 + Math.random() * 0.67,
            fallProgress: Math.random(),
            fallSpeed: 1.2 + Math.random() * 1.4,
            radius: 0.4 + Math.random() * 0.55,
            phase: Math.random() * Math.PI * 2,
            period: 20_000 + Math.random() * 25_000,
            brightness: 0.12 + Math.random() * 0.13,
        }));
        let width = 0;
        let height = 0;
        let frame = 0;
        let lastDraw = -Infinity;

        function draw(time: number) {
            const lightStyle = getComputedStyle(ambientLight);
            const lightXRatio = (parseFloat(lightStyle.getPropertyValue("--ambient-light-x")) || 50) / 100;
            const lightYRatio = (parseFloat(lightStyle.getPropertyValue("--ambient-light-y")) || 50) / 100;
            const lightX = width * lightXRatio;
            const lightY = height * lightYRatio;

            animatedStatic?.draw(time / 1000, lightXRatio, lightYRatio);

            ctx.clearRect(0, 0, width, height);
            ctx.fillStyle = "#f4efe2";

            const fallDistance = height * 0.71;

            for (const mote of motes) {
                const phase = mote.phase + time / mote.period * Math.PI * 2;
                const travelled = (mote.fallProgress * fallDistance + time * mote.fallSpeed / 1000) % fallDistance;
                const y = height * 0.18 + travelled;
                const x = mote.x * width + (y - height * 0.5) * 0.12 + Math.sin(phase) * 2;
                const distance = Math.hypot((x - lightX) / (width * 0.43), (y - lightY) / (height * 0.46));
                const illumination = Math.exp(-2 * (distance / 0.25) ** 2);
                if (illumination < 0.02) continue;

                ctx.globalAlpha = mote.brightness * illumination;
                ctx.beginPath();
                ctx.arc(x, y, mote.radius, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        function animate(time: number) {
            if (time - lastDraw >= 40) {
                draw(time);
                lastDraw = time;
            }
            frame = requestAnimationFrame(animate);
        }

        function resize() {
            width = canvas.clientWidth;
            height = canvas.clientHeight;
            const scale = Math.min(window.devicePixelRatio, 1.5);
            canvas.width = Math.round(width * scale);
            canvas.height = Math.round(height * scale);
            ctx.setTransform(scale, 0, 0, scale, 0, 0);
            animatedStatic?.resize(width, height);
            draw(motion.matches ? performance.now() : 0);
        }

        function updateMotion() {
            cancelAnimationFrame(frame);
            if (motion.matches) {
                frame = requestAnimationFrame(animate);
            } else {
                draw(0);
            }
        }

        resize();
        updateMotion();
        window.addEventListener("resize", resize);
        motion.addEventListener("change", updateMotion);
    }
</script>

<style>
    :global(html) {
        background-color: #1a1a1b;
        color-scheme: dark;
    }

    .portfolio-background {
        margin: 0;
        min-height: 100vh;
        overflow-x: clip;
        isolation: isolate;
        background-color: #1a1a1b;
    }

    @property --ambient-light-x {
        syntax: "<percentage>";
        inherits: true;
        initial-value: 50%;
    }

    @property --ambient-light-y {
        syntax: "<percentage>";
        inherits: true;
        initial-value: 50%;
    }

    .portfolio-background::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -2;
        pointer-events: none;
        background: linear-gradient(to bottom left, #212121 5%, #1a1a1b 50%);
    }

    .portfolio-background::after {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: url("../assets/background-static.png") repeat;
        opacity: 0.08;
    }

    .ambient-viewport {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
    }

    .ambient-light {
        position: absolute;
        inset: -40%;
        transform: translate(
            calc(-3.4 * var(--pointer-shift-x, 0px)),
            calc(-3.4 * var(--pointer-shift-y, 0px))
        );
        --light-shape: ellipse 43% 46% at var(--ambient-light-x, 50%) var(--ambient-light-y, 50%);
        background: radial-gradient(
            var(--light-shape),
            rgb(235 236 240 / 8%),
            rgb(235 236 240 / 5%) 18%,
            rgb(235 236 240 / 2.4%) 35%,
            rgb(235 236 240 / 1.2%) 52%,
            rgb(235 236 240 / 0.45%) 68%,
            rgb(235 236 240 / 0.12%) 82%,
            rgb(235 236 240 / 0%) 100%
        );
    }

    .ambient-light:not(.has-animated-static)::before {
        content: "";
        position: absolute;
        inset: 0;
        background: url("../assets/background-static.png") repeat;
        mask-image: radial-gradient(
            var(--light-shape),
            #000,
            rgb(0 0 0 / 65%) 18%,
            rgb(0 0 0 / 12%) 36%,
            transparent 52%
        );
        opacity: 0.74;
    }

    .ambient-static,
    .ambient-dust {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    @media (prefers-reduced-motion: no-preference) {
        .ambient-light {
            animation: glow-horizontal 160s ease-in-out infinite, glow-vertical 160s ease-in-out -40s infinite;
        }
    }

    @keyframes glow-horizontal {
        0%, 100% { --ambient-light-x: 40%; }
        50% { --ambient-light-x: 60%; }
    }

    @keyframes glow-vertical {
        0%, 100% { --ambient-light-y: 43%; }
        50% { --ambient-light-y: 57%; }
    }

</style>
