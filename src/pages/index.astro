---
import Header from '../components/header.astro';
import Layout from '../layouts/Layout.astro';
import Links from "../components/links.astro";
import Projects from "../components/projects.astro";
import Experience from "../components/experience.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
---

<Layout>
	<div class="linkbar fixed inset-x-0 top-0 z-100 backdrop-blur-sm" inert>
		<div class="page-column">
			<div class="foreground-plane flex flex-row gap-4">
				<Links />
			</div>
		</div>
	</div>
	<div class="page-column portfolio-foreground">
		<div class="foreground-plane flex flex-row gap-4">
			<Links />
		</div>
		<div class="foreground-plane"><Header /></div>
		<div class="foreground-plane"><Experience /></div>
		<Projects />
		<div class="foreground-plane"><Footer /></div>
	</div>
</Layout>

<style>
    @reference "../styles/global.css";

    .page-column {
        @apply mx-auto max-w-[430px] px-6 py-6;
    }

    .linkbar {
        visibility: hidden;
        transform: translateY(-100%);
        transition: transform 260ms ease, visibility 0s linear 260ms;
    }

    .linkbar.is-open {
        visibility: visible;
        transform: translateY(0);
        transition-delay: 0s;
    }

    @media (prefers-reduced-motion: reduce) {
        .linkbar {
            transition: none;
        }
    }
</style>

<script>
    const foreground = document.querySelector<HTMLElement>(".portfolio-foreground");
    const pointerMotion = window.matchMedia("(any-pointer: fine) and (prefers-reduced-motion: no-preference)");

    if (foreground) {
        const layers = document.documentElement;
        let x = 0;
        let y = 0;
        let targetX = 0;
        let targetY = 0;
        let frame = 0;
        let previousTime = 0;

        function renderPerspective() {
            layers.style.setProperty("--pointer-tilt-x", `${-y * 2.5}deg`);
            layers.style.setProperty("--pointer-tilt-y", `${x * 4.5}deg`);
            layers.style.setProperty("--pointer-shift-x", `${x * 4.5}px`);
            layers.style.setProperty("--pointer-shift-y", `${y * 3}px`);
        }

        function followPointer(time: number) {
            const elapsed = previousTime ? Math.min(time - previousTime, 50) : 16;
            previousTime = time;
            const blend = 1 - Math.exp(-elapsed / 105);
            x += (targetX - x) * blend;
            y += (targetY - y) * blend;

            if (Math.hypot(targetX - x, targetY - y) < 0.002) {
                x = targetX;
                y = targetY;
                frame = 0;
                previousTime = 0;
            } else {
                frame = requestAnimationFrame(followPointer);
            }

            renderPerspective();
        }

        function queuePerspective() {
            if (!frame) frame = requestAnimationFrame(followPointer);
        }

        function settlePerspective() {
            targetX = 0;
            targetY = 0;
            if (x || y || frame) queuePerspective();
        }

        window.addEventListener("pointermove", (event) => {
            if (!pointerMotion.matches || event.pointerType !== "mouse") {
                settlePerspective();
                return;
            }

            targetX = (event.clientX / window.innerWidth - 0.5) * 2;
            targetY = (event.clientY / window.innerHeight - 0.5) * 2;
            queuePerspective();
        }, { passive: true });

        document.documentElement.addEventListener("pointerleave", settlePerspective);
        window.addEventListener("blur", settlePerspective);
        pointerMotion.addEventListener("change", () => {
            cancelAnimationFrame(frame);
            frame = previousTime = x = y = targetX = targetY = 0;
            renderPerspective();
        });
    }

    const linkbar = document.querySelector<HTMLElement>(".linkbar");

    if (linkbar) {
        const menu = linkbar;
        let isOpen = false;

        function updateMenu() {
            const shouldOpen = window.scrollY > (isOpen ? 72 : 100);
            if (shouldOpen === isOpen) return;

            isOpen = shouldOpen;
            menu.classList.toggle("is-open", isOpen);
            menu.inert = !isOpen;
        }

        updateMenu();
        window.addEventListener("scroll", updateMenu, { passive: true });
        window.addEventListener("pageshow", updateMenu);
    }
</script>
